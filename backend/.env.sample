# The database the API actually reads/writes.
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<database_name>
DATABASE_USER=<user>
DATABASE_PASSWORD=<password>

# app/sql/seed_companies.sql opens with `TRUNCATE TABLE company CASCADE`,
# which wipes jobposting + job_category/job_location/job_skill along with
# it (cascades through the FK graph). true means every API start destroys
# any Silver-synced data back down to the 12 hardcoded demo postings. Only
# set true for a genuine from-scratch reseed on a database you don't mind
# emptying - see README.md "Run the API" / backend/SILVER_SYNC.md.
SEED_ON_STARTUP=false

ENVIRONMENT=development
JWT_SECRET_KEY=<generate-a-long-random-secret>
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REMEMBER_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
PASSWORD_RESET_TOKEN_MINUTES=20
PASSWORD_RESET_MAX_REQUESTS=5
PASSWORD_RESET_WINDOW_SECONDS=900
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password

# Required to deliver password-reset and password-changed emails outside tests.
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_STARTTLS=true

# Required by POST /api/v1/jobs. Keep this server-to-server key out of source
# control and send it in the X-Job-Write-Key header.
JOB_WRITE_API_KEY=<generate-a-long-random-secret>

# Source database for `python -m app.sync_silver` (must contain
# silver.cleaned_job_postings, built by the scrapers' dbt project). See
# backend/SILVER_SYNC.md.
SILVER_DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<scraper_database_name>

# Optional: mirrors the backend's public schema to Supabase after every
# successful sync_silver/import_categories/import_skills/import_salary run.
# Use the connection-pooler string (Supabase dashboard -> "Connect" ->
# Transaction/Session pooler), not the direct db.<ref>.supabase.co host -
# that one is IPv6-only. Leave unset to disable mirroring entirely. See
# README.md "Supabase mirror (optional)".
# SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
