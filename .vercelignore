# vercel CLI deploys the raw local working directory and does not reliably
# fall back to .gitignore (especially nested ones like frontend/.gitignore)
# the way `git` itself does - `vercel --prod` from source uploaded ~900MB
# and hit the 100MB per-file limit on .venv's bundled CUDA/torch libraries
# before this file existed. Everything here is either multi-GB ML tooling
# unrelated to the deployed app, or a build output Vercel regenerates
# itself from source during the build step.

.git/
.venv/
node_modules/
.next/


# ML/data tooling - not part of the deployed frontend or API. The Python
# function bundles every file it can reach with no tree-shaking, and that
# bundling isn't scoped by this file - only notebooks/checkpoints/ (260MB
# of saved model checkpoints) is excluded here, not the 5 small (~50-90KB)
# notebooks/*.ipynb files themselves or scrapers/data/snapshots/ (132KB
# total): excluding those from upload while the Python builder still tried
# to reference them produced a dangling symlink (readlink ENOENT) on
# Vercel's remote finalize step.
notebooks/checkpoints/
checkpoints/
/data/
scrapers/data/train_result/

# Local caches/artifacts
.pytest_cache/
.ruff_cache/
.coverage
app.log
*.log

