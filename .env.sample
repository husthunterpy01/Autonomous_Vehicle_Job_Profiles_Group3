# Copy to .env (repo root, gitignored) and fill in. `docker compose up`
# reads this file automatically to fill the ${VAR} placeholders in
# docker-compose.yaml - it's read by the `docker compose` CLI on the host,
# before any container starts, never copied or mounted into a container.
#
# This is independent of backend/.env.sample and scrapers/.env.sample: those
# configure the backend/scrapers when run directly on your machine (outside
# Docker). The Compose backend uses SUPABASE_DATABASE_URL below as its
# DATABASE_URL; it does not read backend/.env.

# Same requirement as backend/.env.sample's JWT_SECRET_KEY - generate with
# `openssl rand -hex 32`, don't reuse a memorable value.
JWT_SECRET_KEY=<generate-a-long-random-secret>

# Session-mode pooler URL (Supabase dashboard -> Connect). Include
# sslmode=require. docker-compose passes this through as the backend's
# DATABASE_URL. Do not set SEED_ON_STARTUP=true against this database.
# SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
