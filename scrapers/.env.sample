# Copy to scrapers/.env and fill in. scrapers/.env is git-ignored.

# --- MinIO (raw parquet archives of scraped jobs) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_JOBS_BUCKET=av-scraped-jobs

# --- Postgres (same database + credentials as the backend) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=autojobdatabase
POSTGRES_USER=team3
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=bronze
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=5

# --- ATS secrets (also set these as CI secrets) ---
# Comeet's public read-only careers-API token, taken from the Comeet careers
# page HTML (COMPANY_DATA.token). Required for the `comeet` ATS (autobrains).
COMEET_TOKEN=

# --- Groq (LLM AV-relevance classification + category/skill enrichment) ---
# One or more comma-separated keys, tried in order: after more than 3
# consecutive rate-limit errors on the active key, the client rotates to the
# next one automatically (see scrapers/service/llm/groq_client.py). A single
# key works the same way with an implicit pool of one.
GROQ_API_KEY=
# Optional overrides (defaults shown; see scrapers/config/groq.py):
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_TEMPERATURE=0
# GROQ_REASONING_EFFORT=low
# GROQ_MAX_COMPLETION_TOKENS=4096
# GROQ_TPM_LIMIT=8000

# --- Headless Chrome (only for html_sources with `render: true`) ---
# Optional. Leave unset to let Selenium Manager locate Chrome for your OS.
# Set only when Chrome lives somewhere non-standard, e.g.:
#   Linux:   /usr/bin/google-chrome
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_BIN=
