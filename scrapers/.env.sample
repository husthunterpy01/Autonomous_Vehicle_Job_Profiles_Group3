# Copy to scrapers/.env and fill in. scrapers/.env is git-ignored.

# --- MinIO (raw parquet archives of scraped jobs) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_JOBS_BUCKET=av-scraped-jobs

# --- Postgres (same database + credentials as the backend) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=autojobdatabase
POSTGRES_USER=team3
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=bronze
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=5

# --- ATS secrets (also set these as CI secrets) ---
# Comeet's public read-only careers-API token, taken from the Comeet careers
# page HTML (COMPANY_DATA.token). Required for the `comeet` ATS (autobrains).
COMEET_TOKEN=
